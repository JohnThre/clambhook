#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Pengfan Chang <support@swiphtgroup.com>
# SPDX-License-Identifier: GPL-3.0-only


VERSION := $(shell head -1 $(CURDIR)/debian/changelog | cut -d' ' -f2 | tr -d '()' | cut -d- -f1)

%:
	dh $@

# The desktop controller bundles a private jlink runtime; build it with the
# distribution's JDK 21 (jpackage + jmods).
export JAVA_HOME ?= /usr/lib/jvm/java-21-openjdk-$(shell dpkg-architecture -qDEB_HOST_ARCH)
export PATH := $(JAVA_HOME)/bin:$(PATH)
UI_RUNTIME := usr/lib/clambhook/ui

override_dh_auto_build:
	$(MAKE) build VERSION=$(VERSION)
	$(MAKE) build-linux VERSION=$(VERSION)

override_dh_auto_test:
	$(MAKE) test-native
	$(MAKE) test-linux

override_dh_auto_install:
	$(MAKE) install VERSION=$(VERSION) DESTDIR=$(CURDIR)/debian/clambhook PREFIX=/usr
	$(MAKE) install-linux VERSION=$(VERSION) DESTDIR=$(CURDIR)/debian/clambhook PREFIX=/usr
	install -Dpm 0644 keys/clambhook-release-key.asc $(CURDIR)/debian/clambhook/usr/share/keyrings/clambhook-archive-keyring.asc
	install -Dpm 0644 packaging/repos/clambhook.sources $(CURDIR)/debian/clambhook/etc/apt/sources.list.d/clambhook.sources

# The private desktop runtime ships as built by jlink: do not strip or dwz it,
# and resolve its internal libraries when computing shared-library depends.
override_dh_strip:
	dh_strip -X$(UI_RUNTIME)

override_dh_dwz:
	dh_dwz -X$(UI_RUNTIME)

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/clambhook/$(UI_RUNTIME)/lib/runtime/lib:$(CURDIR)/debian/clambhook/$(UI_RUNTIME)/lib/runtime/lib/server

# dh_installdocs recreates the package documentation directory after CMake's
# install step. Restore the structured third-party license tree after
# dh_compress as well, preserving the exact uncompressed paths validated by
# the installed-package smoke test.
override_dh_compress:
	dh_compress
	install -Dpm 0644 third_party/openssl/LICENSE.txt $(CURDIR)/debian/clambhook/usr/share/doc/clambhook/licenses/openssl/LICENSE.txt
	install -Dpm 0644 third_party/curl/LICENSE.txt $(CURDIR)/debian/clambhook/usr/share/doc/clambhook/licenses/curl/LICENSE.txt
	install -Dpm 0644 third_party/llhttp/LICENSE $(CURDIR)/debian/clambhook/usr/share/doc/clambhook/licenses/llhttp/LICENSE
