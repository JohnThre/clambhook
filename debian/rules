#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Pengfan Chang <support@swiphtgroup.com>
# SPDX-License-Identifier: GPL-3.0-only


export CGO_ENABLED=1
export GO111MODULE=on
export GOFLAGS=-mod=vendor -buildvcs=false
export PATH := /usr/local/go/bin:$(PATH)

VERSION := $(shell head -1 $(CURDIR)/debian/changelog | cut -d' ' -f2 | tr -d '()' | cut -d- -f1)

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build VERSION=$(VERSION)
	$(MAKE) build-linux VERSION=$(VERSION)

override_dh_auto_install:
	$(MAKE) install VERSION=$(VERSION) DESTDIR=$(CURDIR)/debian/clambhook PREFIX=/usr
	$(MAKE) install-linux VERSION=$(VERSION) DESTDIR=$(CURDIR)/debian/clambhook PREFIX=/usr

override_dh_dwz:
	# Skip dwz: Go binaries have compressed debug sections that break dwz.

