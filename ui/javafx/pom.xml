<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jpfchang.clambhook</groupId>
    <artifactId>clambhook-ui</artifactId>
    <version>1.0.2</version>
    <name>ClambHook JavaFX UI</name>
    <description>Shared JavaFX controller for ClambHook on Android and GNU/Linux.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-08-29T00:00:00Z</project.build.outputTimestamp>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>26.0.2</javafx.version>
        <!-- Gluon's public Substrate ABI bundle is independent of the Maven
             JavaFX API/runtime artifacts and is the latest JavaFX 21 static
             bundle published for every locked target. -->
        <javafx.static.version>21.0.1</javafx.static.version>
        <junit.version>6.1.3</junit.version>
        <gluonfx.version>1.0.29</gluonfx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <main.class>com.clambhook.ui.ClambhookApplication</main.class>
        <gluonfx.target>host</gluonfx.target>
        <clambhook.version.code>3</clambhook.version.code>
        <clambhook.version.name>${project.version}</clambhook.version.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>clambhook-ui</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED -Djavafx.cachedir=${project.build.directory}/javafx-cache</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <append>false</append>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>CLASS</counter>
                                    <value>TOTALCOUNT</value>
                                    <minimum>1</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>${gluonfx.version}</version>
                <configuration>
                    <target>${gluonfx.target}</target>
                    <mainClass>${main.class}</mainClass>
                    <executable>clambhook-ui</executable>
                    <appIdentifier>org.jpfchang.clambhook</appIdentifier>
                    <javafxStaticSdkVersion>${javafx.static.version}</javafxStaticSdkVersion>
                    <resourcesList>
                        <list>com/clambhook/ui/clambhook.css</list>
                        <list>THIRD_PARTY_NOTICES.md</list>
                    </resourcesList>
                    <reflectionList>
                        <list>com.clambhook.ui.ClambhookApplication</list>
                    </reflectionList>
                    <nativeImageArgs>
                        <arg>-H:+ReportExceptionStackTraces</arg>
                        <arg>-H:+AddAllCharsets</arg>
                    </nativeImageArgs>
                    <releaseConfiguration>
                        <appLabel>ClambHook</appLabel>
                        <versionCode>${clambhook.version.code}</versionCode>
                        <versionName>${clambhook.version.name}</versionName>
                        <vendor>Pengfan Chang</vendor>
                        <description>ClambHook network routing and privacy controller</description>
                    </releaseConfiguration>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../..</directory>
                <includes>
                    <include>THIRD_PARTY_NOTICES.md</include>
                </includes>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>desktop</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <gluonfx.target>host</gluonfx.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <configuration>
                            <reflectionList combine.children="append">
                                <list>com.clambhook.ui.backend.HttpBackend</list>
                                <list>com.clambhook.ui.platform.DesktopPlatformServices</list>
                            </reflectionList>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>android</id>
            <properties>
                <gluonfx.target>android</gluonfx.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <configuration>
                            <reflectionList combine.children="append">
                                <list>com.clambhook.ui.backend.AndroidBackend</list>
                                <list>com.clambhook.ui.platform.AndroidPlatformServices</list>
                            </reflectionList>
                            <jniList>
                                <list>com.clambhook.ui.platform.AndroidDalvikBridge</list>
                            </jniList>
                            <linkerArgs>
                                <arg>-Wl,--whole-archive</arg>
                                <arg>${project.basedir}/../android/app/build/gluon/libclambhook_gluon_bridge.a</arg>
                                <arg>-Wl,--no-whole-archive</arg>
                            </linkerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>android-signed</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <configuration>
                            <releaseConfiguration>
                                <providedKeyStorePath>${env.CLAMBHOOK_ANDROID_KEYSTORE_PATH}</providedKeyStorePath>
                                <providedKeyStorePassword>${env.CLAMBHOOK_ANDROID_KEYSTORE_PASSWORD}</providedKeyStorePassword>
                                <providedKeyAlias>${env.CLAMBHOOK_ANDROID_KEY_ALIAS}</providedKeyAlias>
                                <providedKeyAliasPassword>${env.CLAMBHOOK_ANDROID_KEY_PASSWORD}</providedKeyAliasPassword>
                            </releaseConfiguration>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
