<!-- Android 12 (API 31) and below. Exclude license/auth secrets from cloud backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="clambhook_secrets.xml" />
    <exclude domain="sharedpref" path="clambhook_license.xml" />
    <exclude domain="file" path="clambhook/" />
</full-backup-content>
