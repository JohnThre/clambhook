[Desktop Entry]
Name=clambhook
GenericName=Network Client
Comment=Control clambhook proxy profiles, listeners, and traffic
Exec=clambhook-linux
Icon=@app_id@
Terminal=false
Type=Application
Categories=Network;Utility;
Keywords=proxy;vpn;tunnel;network;traffic;
StartupNotify=true
