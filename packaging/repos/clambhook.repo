#
# Signed ClambHook dnf repository for Fedora. Both packages (gpgcheck) and
# repository metadata (repo_gpgcheck) must be signed by the
# developer@jpfchang.org release key.
[clambhook]
name=ClambHook
baseurl=https://jpfchang.org/clambhook/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-clambhook
