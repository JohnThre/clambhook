<!-- debsig-verify policy for ClambHook .deb packages. The keyring is generated
     from keys/clambhook-release-key.asc (developer@jpfchang.org); signatures
     must come from the pinned signing subkey EAA876B70B1832F5. -->
<!DOCTYPE Policy SYSTEM "https://www.debian.org/debsig/1.0/policy.dtd">
<Policy xmlns="https://www.debian.org/debsig/1.0/">
  <Origin Name="ClambHook" id="EAA876B70B1832F5" Description="ClambHook release key (developer@jpfchang.org)"/>
  <Selection>
    <Required Type="origin" File="debsig.gpg" id="EAA876B70B1832F5"/>
  </Selection>
  <Verification MinOptional="0">
    <Required Type="origin" File="debsig.gpg" id="EAA876B70B1832F5"/>
  </Verification>
</Policy>
