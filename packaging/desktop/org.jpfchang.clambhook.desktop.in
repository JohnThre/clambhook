[Desktop Entry]
Name=ClambHook
GenericName=Network Client
Comment=Control ClambHook profiles, routing, privacy, and traffic
Exec=clambhook-ui %u
Icon=@app_id@
Terminal=false
Type=Application
Categories=Network;Utility;
Keywords=proxy;vpn;tunnel;network;traffic;
StartupNotify=true
MimeType=x-scheme-handler/ss;x-scheme-handler/ssconf;
