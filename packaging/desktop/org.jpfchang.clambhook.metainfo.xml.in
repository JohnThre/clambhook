<component type="desktop-application">
  <id>@app_id@</id>
  <name>ClambHook</name>
  <summary>Control profiles, policies, DNS, capture, and traffic</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer_name>Pengfan Chang</developer_name>
  <description>
    <p>ClambHook for GNU/Linux manages daemon connectivity, profiles, server chains, policies, routing rules, prompts, encrypted DNS, firewall and conditioner settings, HTTP(S) developer capture, licensing, and traffic from a self-contained JavaFX and Gluon native application.</p>
    <p>The application communicates only with the local C17 daemon over its authenticated loopback control and event interfaces.</p>
  </description>
  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <url type="homepage">https://github.com/JohnThre/clambhook</url>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>proxy</keyword>
    <keyword>vpn</keyword>
    <keyword>tunnel</keyword>
    <keyword>network</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="1.0.2" date="2026-08-29" />
  </releases>
</component>
